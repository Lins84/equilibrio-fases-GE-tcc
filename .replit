entrypoint = "interface/fletando_grafico.py"
modules = ["nodejs-20", "python-3.11"]

[nix]
channel = "stable-24_05"
packages = ["nano"]

[unitTest]
language = "python3"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["uv", "run", "python3", "interface/fletando_grafico.py"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start Grafico"

[[workflows.workflow]]
name = "Start Grafico"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python3 interface/fletando_grafico.py"
waitForPort = 5000

[userenv]

[userenv.shared]
CLAUDE_CONFIG_DIR = "/home/runner/workspace/.claude-config"
